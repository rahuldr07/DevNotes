DB_HOST=localhost
DB_PORT=5432
DB_NAME=devnotes
DB_USER=devnotes
DB_PASSWORD=devnotes
DB_SSL_MODE=disable

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

SECRET_KEY=change-this-local-dev-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development | test | production. "production" refuses placeholder secrets,
# requires DB SSL, and hides /docs, /redoc, /openapi.json.
ENVIRONMENT=development

# Browser origins allowed to call the API directly. With the Next BFF proxy in
# front of FastAPI, production usually wants this empty.
CORS_ORIGINS=http://localhost:3000

# Enable ONLY when a trusted reverse proxy is the sole ingress and overwrites
# X-Forwarded-For. Otherwise anonymous rate limits key on the direct peer.
# The Next proxy drops client-supplied forwarding headers unless it is itself
# started with TRUSTED_PROXY_HEADERS=1.
TRUST_FORWARDED_FOR=false

# Used only by scripts/create_postgres_db.py when creating the database.
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres

# Integration tests (tests/integration) run the migrations and every
# Postgres-only query against a real database. Point them at one, or let the
# package skip. CI sets REQUIRE_INTEGRATION_DB=1 so a skip fails the build.
# TEST_DATABASE_URL=postgresql://devnotes:devnotes@localhost:5432/devnotes_test
